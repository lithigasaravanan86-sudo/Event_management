# ========================================================
# College Event Management System (CEMS) - Configuration
# ========================================================

# Flask Secret Key
SECRET_KEY=cems_super_secret_college_key_2026

# Database Type: 'mysql' (default) or 'sqlite'
# If 'mysql' is selected and MySQL is offline, CEMS will gracefully auto-fallback to SQLite
DB_TYPE=mysql

# MySQL Settings (Standard XAMPP / Local MySQL defaults)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=cems_db
